{
  "swagger": "2.0",
  "info": {
    "title": "CSE 341 Project 2 API",
    "description": "REST API documentation for Products and Orders management (Week 3 & Week 4). Requires authentication for state-modifying and query endpoints under /products and /orders.",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "paths": {
    "/api-docs": {
      "get": {
        "description": "",
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Root"
        ],
        "summary": "API Root",
        "description": "Welcome endpoint for CSE 341 Project 2 API. Displays current login status.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/login": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in via GitHub OAuth",
        "description": "Redirects the user to GitHub to authenticate. Requires setting up GitHub OAuth credentials.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/github/callback": {
      "get": {
        "tags": [
